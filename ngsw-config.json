{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    { "name": "aplicacion", "installMode": "prefetch", "resources": { "files": ["/index.html", "/*.css", "/*.js", "/manifest.webmanifest"] } },
    { "name": "recursos", "installMode": "lazy", "updateMode": "prefetch", "resources": { "files": ["/assets/**"] } }
  ]
}
